# Copiar a `.env` y completar.

# Puerto del servidor (default: 3002)
PORT=3002

# Password única para entrar a la app (la usa tu papá para loguearse)
APP_PASSWORD=cambiame

# Secreto para firmar los tokens de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ---------------------------------------------------------------------------
# IA
# ---------------------------------------------------------------------------
# Alcanza con UNA de las dos claves para que la app arranque: si falta la del
# proveedor que le toca a una tarea, se usa el otro y queda avisado en el log.

# Groq — gratis en https://console.groq.com/keys
# Atiende lo rápido y barato: sugerencias mientras se tipea, ortografía,
# transcripción de voz (Whisper) y la búsqueda web del chat.
GROQ_API_KEY=

# Claude — https://console.anthropic.com
# Atiende lo que sale caro equivocar: editar items, leer fotos y archivos, chat.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------
# Modelos (los defaults ya son los recomendados)
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
CLAUDE_MODEL=claude-sonnet-5

# Ruteo por tarea. Sirve para mover una tarea de proveedor sin tocar código,
# por ejemplo para probar cuál te rinde mejor o para bajar costos.
# Valores: groq | claude
#   AI_ROUTE_PARSE=groq        (dictado y texto libre → items)
#   AI_ROUTE_COMMAND=claude    (editar items existentes)
#   AI_ROUTE_VISION=claude     (fotos y archivos)
#   AI_ROUTE_CHAT=claude       (asistente del presupuesto)
#   AI_ROUTE_SUGGEST=groq      (autocompletado)
#   AI_ROUTE_SPELLCHECK=groq   (ortografía)
#   AI_ROUTE_CLIENT_DATA=groq  (datos del cliente)
#   AI_ROUTE_VOZ_CORTAR=groq   (conversación por voz: separar lo dictado en pedidos)
#   AI_ROUTE_VOZ_TURNO=claude  (conversación por voz: decidir los cambios)

# Modelo rápido de Groq para cortar lo dictado en pedidos (si no, usa GROQ_MODEL)
# GROQ_FAST_MODEL=

# ---------------------------------------------------------------------------
# Voz (ElevenLabs) — https://elevenlabs.io
# ---------------------------------------------------------------------------
# Lee las respuestas en voz alta y, en el modo conversación, escucha en vivo
# (Scribe Realtime). Sin la clave, se usa la voz del dispositivo y Groq Whisper.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Voz de baja latencia para la conversación en vivo
# ELEVENLABS_FAST_MODEL_ID=eleven_flash_v2_5
# Velocidad de habla, de 0.7 a 1.2 (1 = normal de la voz)
# ELEVENLABS_SPEED=1.1
