# Copiar a `.env` y completar.

# Puerto del servidor (default: 3002)
PORT=3002

# Password única para entrar a la app (la usa tu papá para loguearse)
APP_PASSWORD=cambiame

# Secreto para firmar los tokens de sesión. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# API key de Groq (gratis en https://console.groq.com/keys)
GROQ_API_KEY=

# Opcional — modelo (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
